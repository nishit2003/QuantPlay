# ─── Database ────────────────────────────────────────────────────────────────
# Local / direct: use your MySQL URL (e.g. Railway, localhost).
DATABASE_URL="mysql://user:password@localhost:3306/robinhood_clone"
# When using Prisma Accelerate on Vercel, set DATABASE_URL to the prisma:// URL
# and DIRECT_DATABASE_URL to your direct MySQL URL (for migrations). See ACCELERATE_SETUP.md.
# DIRECT_DATABASE_URL="mysql://user:password@host:port/database"

# ─── NextAuth / Auth.js ──────────────────────────────────────────────────────
# Local dev:
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"  # openssl rand -base64 32
# Vercel production: set in Project → Settings → Environment Variables:
#   AUTH_SECRET = same secret (or NEXTAUTH_SECRET) — required
#   AUTH_URL = https://your-app.vercel.app  (e.g. https://quant-play.vercel.app)

# ─── OAuth Providers (Google example — add more as needed) ───────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Market Data ────────────────────────────────────────────────────────────
# When set, app uses Finnhub (real-time, accurate). Otherwise uses Yahoo Finance.
FINNHUB_API_KEY=""

# ─── Cron (run-once endpoints; call from Vercel Cron / cron-job.org) ─────────
# Pass as Authorization: Bearer <CRON_SECRET> or ?secret=<CRON_SECRET>
CRON_SECRET="generate-a-random-cron-secret"

# ─── Feedback form (emails suggestions to you) ─────────────────────────────
FEEDBACK_TO_EMAIL="your@email.com"
RESEND_API_KEY="re_xxxx"
# Optional: custom "from" address (must be verified in Resend). Default: onboarding@resend.dev
# RESEND_FROM_EMAIL="QuantPlay <feedback@yourdomain.com>"

# Optional: Error tracking. Get a DSN at https://sentry.io and add @sentry/nextjs to enable.
# SENTRY_DSN=
